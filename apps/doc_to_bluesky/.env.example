# apps/doc_to_bluesky -- example environment configuration.
#
# Copy to `.env`, fill in real values LOCALLY ONLY, and never commit `.env`
# (already gitignored). ZERO real values below -- every value is a placeholder.
#
# NOTE: zeocore itself stores resolved credentials OUTSIDE this repository,
# in an OS-appropriate per-user directory at file mode 600. You cannot
# accidentally commit a token by running this app.

# --- Google (Docs) ----------------------------------------------------
# The OAuth CLIENT SECRETS json you download from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Desktop app).
GOOGLE_CLIENT_SECRETS_FILE=/absolute/path/to/client_secrets.json

# Where the STORED USER TOKEN is written. THIS FILE DOES NOT EXIST YET --
# it is created for you when the OAuth consent flow completes in your
# browser on the first real run. Point it somewhere writable.
GOOGLE_CREDENTIALS_FILE=/absolute/path/to/credentials.json

# --- Bluesky ----------------------------------------------------------
# Your handle (you.bsky.social) or the account email.
BLUESKY_IDENTIFIER=your-handle.bsky.social

# An APP PASSWORD from Settings -> App Passwords. NEVER your account
# password. No developer app, no OAuth, no approval wait is needed.
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional -- only for a non-default PDS host. Defaults to https://bsky.social
BLUESKY_SERVICE_URL=https://bsky.social
